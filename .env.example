# Environnement Production Hostinger (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u949783941_awakecrm
DB_USER=u949783941_awakecrm_user
DB_PASSWORD=À_REMPLACER_PAR_LE_MOT_DE_PASSE_MYSQL
DB_POOL_SIZE=10

# Migrations MySQL appliquées automatiquement au premier accès (mettre 0 pour désactiver)
DB_AUTO_MIGRATE=1

# Premier compte administrateur (créé UNIQUEMENT si la table users est vide).
# Mot de passe : 14 caractères minimum. Peut être retiré une fois le compte créé.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=Administrateur
BOOTSTRAP_PASSWORD=

# Origine publique exacte (Protection CSRF)
APP_ORIGIN=https://awake-darkslateblue-rabbit-60.hostingersite.com

# Mode base de données: "mysql" (Hostinger / Production) | "pglite" (aperçu local sans MySQL) | "postgres"
DATABASE_MODE=mysql
DATABASE_URL=

# Stockage sécurisé des documents (chemin hors du dossier public/)
STORAGE_DIR=.data/uploads
MAX_UPLOAD_BYTES=10485760

# Port HTTP (fourni automatiquement par Hostinger en production)
PORT=3000