# Production/team use: PostgreSQL, no automatic fallback.
DATABASE_MODE=postgres
DATABASE_URL=postgres://gopermis:change-me@localhost:5432/gopermis
APP_ORIGIN=http://localhost:3000
# Private local preview instead: DATABASE_MODE=pglite and DATABASE_URL empty.
# PGLITE_DATA_DIR=.data/preview
# Create the first admin once using private environment settings:
# BOOTSTRAP_IDENTIFIER=admin
# BOOTSTRAP_NAME=Administrateur GoPermis
# BOOTSTRAP_PASSWORD must be set securely; no default password is supplied.
